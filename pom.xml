<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- 独立工程：不进根 pom 聚合，仅通过 BOM 消费基座发布件（积木式组装）。
         mse-monolith 聚合了 mse-modules 业务积木，构建前需先 mvn install 根目录（framework）与 mse-modules 各工程 -->
    <groupId>com.github.magoo-lau.mse-sample</groupId>
    <artifactId>mse-sample</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>mse-sample</name>
    <description>示例区：mse-monolith 单体示例（聚合基座 + 业务积木）+ mse-demo 微服务示例工程 + mse-ui-sub 独立前端模板</description>

    <modules>
        <module>mse-monolith</module>
        <module>mse-demo</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- 基座版本：升级基座后改这一处即可 -->
        <mse.version>1.0.0-SNAPSHOT</mse.version>
        <!-- 与基座 mse-dependencies BOM 的 spring-boot 版本保持一致 -->
        <spring-boot.version>4.0.8</spring-boot.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- 基座 BOM：仲裁全部第三方 + 基座模块（common-* / service-* / api-*）版本 -->
            <dependency>
                <groupId>com.github.magoo-lau.mse-framework</groupId>
                <artifactId>mse-dependencies</artifactId>
                <version>${mse.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <!-- 所有模块共用的基础依赖 -->
    <dependencies>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>${spring-boot.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.13.0</version>
                    <configuration>
                        <release>21</release>
                        <parameters>true</parameters>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

    <repositories>
    <repository>
        <id>jitpack</id>
        <url>https://jitpack.io</url>
    </repository>

        <repository>
            <id>central</id>
            <url>https://repo.maven.apache.org/maven2</url>
        </repository>
        <repository>
            <id>aliyun</id>
            <url>https://maven.aliyun.com/repository/public</url>
        </repository>
    </repositories>
</project>
